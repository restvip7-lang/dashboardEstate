{
  "name": "stayproperty-director-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Director TV dashboard for STAYPROPERTY: agency sales and developer portfolio.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && vite preview --port 4173 --open",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo-data": "node scripts/generate-demo.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
